version = 0.1

# Copy this file to samconfig.toml and fill in your own values before deploying.
# samconfig.toml is gitignored because it holds deploy-specific details (your
# AWS account ID in the bucket/CORS origin, chosen region, etc.).

[default.global.parameters]
stack_name = "daily-timeguess"

[default.build.parameters]
cached = true
parallel = true

[default.deploy.parameters]
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
resolve_s3 = true
region = "eu-west-2"
# Serve everything behind a custom domain via CloudFront. Fill in:
#   DomainName      your apex domain (also serves www.<domain>)
#   CertificateArn  an ISSUED ACM cert in us-east-1 covering <domain> and www.<domain>
#   HostedZoneId    the Route 53 hosted zone ID for <domain>
#   CorsOrigin      https://<domain> (same-origin, so this is just a safety net)
# For local testing, override with:
#   sam deploy --parameter-overrides "CorsOrigin=* AllowDateOverride=true"
parameter_overrides = "CorsOrigin=https://<YOUR_DOMAIN> AllowDateOverride=false DomainName=<YOUR_DOMAIN> CertificateArn=arn:aws:acm:us-east-1:<YOUR_AWS_ACCOUNT_ID>:certificate/<CERT_ID> HostedZoneId=<YOUR_HOSTED_ZONE_ID>"
